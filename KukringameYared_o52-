
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>KuKirin G2 - Police Chase</title>
<style>
*{box-sizing:border-box}
body{margin:0;overflow:hidden;background:#101820;font-family:Arial,sans-serif;color:white}
#game{position:fixed;inset:0}
#hud{position:fixed;top:12px;left:12px;z-index:2;background:#101820cc;padding:12px 15px;border-radius:12px;line-height:1.6}
#title{font-weight:bold;font-size:18px;color:#63e6ff}
#help{font-size:12px;color:#ddd}
#message{color:#ff6262;font-weight:bold}
#controls{position:fixed;bottom:22px;left:0;right:0;display:flex;justify-content:space-between;align-items:end;padding:0 20px;z-index:3;pointer-events:none}
.group{display:flex;gap:10px;pointer-events:auto}
button{border:2px solid #ffffff66;background:#182b3ddd;color:white;border-radius:18px;font-size:23px;font-weight:bold;width:65px;height:65px;touch-action:none;user-select:none;-webkit-user-select:none}
button:active{background:#168cbb}
#gas{height:82px;background:#b72c32dd}
#brake{height:65px;background:#555d69dd}
#restart{width:auto;height:auto;padding:10px 14px;font-size:14px;margin-top:6px}
@media(min-width:800px){#controls{opacity:.8}.group button{width:58px;height:58px}}
</style>
</head>
<body>
<div id="game"></div>
<div id="hud">
  <div id="title">KU KIRIN G2 • POLICE CHASE</div>
  Geschwindigkeit: <span id="speed">0</span> km/h<br>
  Polizei: <span id="police">Sucht dich</span><br>
  <span id="message">Fahre los!</span><br>
  <span id="help">PC: W/A/S/D oder Pfeile · Shift: Turbo</span><br>
  <button id="restart">↻ Neustart</button>
</div>

<div id="controls">
  <div class="group">
    <button id="left" aria-label="Links">◀</button>
    <button id="right" aria-label="Rechts">▶</button>
  </div>
  <div class="group">
    <button id="brake" aria-label="Bremsen">▼</button>
    <button id="gas" aria-label="Gas">▲</button>
  </div>
</div>

<script type="module">
import * as THREE from
'https://cdn.jsdelivr.net/npm/three@0.166.1/build/three.module.js';

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x91c9ed);
scene.fog = new THREE.Fog(0x91c9ed, 100, 370);

const camera = new THREE.PerspectiveCamera(
  70, innerWidth/innerHeight, 0.1, 600
);
const renderer = new THREE.WebGLRenderer({antialias:true});
renderer.setSize(innerWidth,innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio,1.7));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
document.getElementById('game').appendChild(renderer.domElement);

scene.add(new THREE.HemisphereLight(0xffffff,0x596b54,2));
const sun = new THREE.DirectionalLight(0xffffff,2.2);
sun.position.set(-40,80,30);
sun.castShadow = true;
scene.add(sun);

const mat=(color,roughness=0.85)=>new THREE.MeshStandardMaterial({color,roughness});
const asphalt=mat(0x343b43), grass=mat(0x47764a),
  white=mat(0xffffff), yellow=mat(0xffd447),
  dark=mat(0x171d23), rubber=mat(0x111111),
  metal=mat(0x9ca8b3), red=mat(0xe62f36),
  blue=mat(0x1766df), glass=mat(0x8fd8ef,0.25);

function cube(parent,w,h,d,material,x,y,z){
  const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),material);
  m.position.set(x,y,z);
  m.castShadow=true;
  m.receiveShadow=true;
  parent.add(m);
  return m;
}

// Ground and city grid
const ground=new THREE.Mesh(new THREE.PlaneGeometry(600,600),grass);
ground.rotation.x=-Math.PI/2;
ground.position.y=-0.13;
ground.receiveShadow=true;
scene.add(ground);

const city=new THREE.Group();
scene.add(city);
const roadWidth=13, block=34, spacing=47;

for(let i=-6;i<=6;i++){
  const x=i*spacing;
  const zroad=i*spacing;

  const road1=new THREE.Mesh(new THREE.PlaneGeometry(roadWidth,600),asphalt);
  road1.rotation.x=-Math.PI/2;
  road1.position.set(x,0,0);
  city.add(road1);

  const road2=new THREE.Mesh(new THREE.PlaneGeometry(600,roadWidth),asphalt);
  road2.rotation.x=-Math.PI/2;
  road2.position.set(0,0,zroad);
  city.add(road2);

  for(let k=-5;k<=5;k++){
    const z=k*20;
    cube(city,0.17,0.025,5,yellow,x,0.025,z);
    cube(city,5,0.025,0.17,yellow,zroad,0.026,x);
  }
}

// Buildings in blocks between roads
const buildingMats=[
  mat(0xb8c0c9),mat(0xc9b6a3),mat(0x879eaf),
  mat(0xe0d8c7),mat(0x9cae9b),mat(0xb4a3c8),
  mat(0x777f89),mat(0xd3a28c)
];
for(let gx=-5;gx<=5;gx++){
  for(let gz=-5;gz<=5;gz++){
    if(Math.abs(gx)<1 && Math.abs(gz)<1) continue;
    const x=gx*spacing+spacing/2;
    const z=gz*spacing+spacing/2;
    const count=2+Math.floor(Math.random()*3);
    for(let b=0;b<count;b++){
      const w=5+Math.random()*9;
      const d=5+Math.random()*9;
      const h=8+Math.random()*37;
      const bx=x+(Math.random()-.5)*23;
      const bz=z+(Math.random()-.5)*23;
      cube(city,w,h,d,buildingMats[Math.floor(Math.random()*buildingMats.length)],
        bx,h/2,bz);
      // Window strips on the street-facing side
      const windowMat=mat(0x78c8e8,0.35);
      for(let wy=3;wy<h-1;wy+=3.2){
        for(let wx=-w/2+1;wx<w/2-0.5;wx+=2.2){
          cube(city,0.9,1.3,0.08,windowMat,bx+wx,wy,bz+d/2+0.045);
        }
      }
    }
  }
}

// Scooter
const scooter=new THREE.Group();
scene.add(scooter);
const chassis=new THREE.Group();
scooter.add(chassis);

// Deck, wheels and fenders
cube(chassis,1.0,0.19,2.3,dark,0,0.72,0.15);
cube(chassis,0.76,0.09,1.75,mat(0x272c33),0,0.83,0.18);

function wheel(parent,x,y,z,r=0.43){
  const tire=new THREE.Mesh(
    new THREE.CylinderGeometry(r,r,0.24,20),rubber);
  tire.rotation.z=Math.PI/2;
  tire.position.set(x,y,z);
  tire.castShadow=true;
  parent.add(tire);
  const hub=new THREE.Mesh(
    new THREE.CylinderGeometry(r*.48,r*.48,0.255,16),metal);
  hub.rotation.z=Math.PI/2;
  hub.position.set(x,y,z);
  parent.add(hub);
}
wheel(chassis,0,0.43,-0.83);
wheel(chassis,0,0.43,1.0);

// Steering column and handlebars
const pole=cube(chassis,0.13,1.25,0.13,metal,0,1.35,-0.68);
pole.rotation.x=-0.20;
cube(chassis,0.92,0.10,0.12,dark,0,1.94,-0.78);
cube(chassis,0.28,0.17,0.24,mat(0x20272d),0,1.98,-0.78);
cube(chassis,0.28,0.16,0.15,red,0,0.94,1.23);

// A simple rider silhouette
const rider=new THREE.Group();
chassis.add(rider);
const skin=mat(0xd4a079), clothes=mat(0x171d2b), helmet=mat(0x20252b);
const torso=cube(rider,0.52,0.72,0.34,clothes,0,1.65,0.05);
torso.rotation.x=-0.25;
const head=new THREE.Mesh(new THREE.SphereGeometry(0.22,16,12),skin);
head.position.set(0,2.12,0.02);
rider.add(head);
const hat=new THREE.Mesh(new THREE.SphereGeometry(0.24,16,12),helmet);
hat.scale.set(1,0.68,1);
hat.position.set(0,2.22,0.02);
rider.add(hat);
for(const side of [-1,1]){
  const arm=cube(rider,0.16,0.58,0.16,clothes,side*.30,1.73,-0.36);
  arm.rotation.x=-0.7;
  const leg=cube(rider,0.19,0.65,0.2,clothes,side*.18,1.12,0.34);
  leg.rotation.x=-0.42;
}

// Police cars
function makePoliceCar(){
  const car=new THREE.Group();
  cube(car,1.85,0.62,3.4,white,0,0.65,0);
  cube(car,1.55,0.65,1.65,blue,0,1.22,-0.15);
  cube(car,1.52,0.35,0.10,glass,0,1.35,0.72);
  cube(car,1.52,0.35,0.10,glass,0,1.35,-0.98);
  cube(car,0.16,0.10,0.7,dark,0,1.65,-0.15);
  cube(car,0.45,0.12,0.23,red,-0.28,1.65,-0.15);
  cube(car,0.45,0.12,0.23,blue,0.28,1.65,-0.15);
  for(const x of [-0.92,0.92]){
    for(const z of [-1.05,1.05]){
      const w=new THREE.Mesh(new THREE.CylinderGeometry(.34,.34,.18,16),rubber);
      w.rotation.z=Math.PI/2;
      w.position.set(x,.38,z);
      car.add(w);
    }
  }
  return car;
}
const policeCars=[];
for(let i=0;i<3;i++){
  const car=makePoliceCar();
  car.position.set((i-1)*4,0,-15-i*9);
  scene.add(car);
  policeCars.push(car);
}

// Input
const keys={};
let gas=0, steer=0, brake=0;
let speed=0, heading=0, wanted=false, gameOver=false;
const maxSpeed=31;
const speedEl=document.getElementById('speed');
const policeEl=document.getElementById('police');
const messageEl=document.getElementById('message');

addEventListener('keydown',e=>{
  keys[e.key.toLowerCase()]=true;
  if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' '].includes(e.key))e.preventDefault();
});
addEventListener('keyup',e=>keys[e.key.toLowerCase()]=false);

function bindHold(id,fn){
  const el=document.getElementById(id);
  const on=e=>{e.preventDefault();fn(true);};
  const off=e=>{e.preventDefault();fn(false);};
  el.addEventListener('pointerdown',on);
  el.addEventListener('pointerup',off);
  el.addEventListener('pointercancel',off);
  el.addEventListener('lostpointercapture',off);
  el.addEventListener('contextmenu',e=>e.preventDefault());
}
bindHold('gas',v=>gas=v?1:0);
bindHold('brake',v=>brake=v?1:0);
bindHold('left',v=>{if(v)steer=-1;else if(steer===-1)steer=0;});
bindHold('right',v=>{if(v)steer=1;else if(steer===1)steer=0;});

document.getElementById('restart').onclick=()=>{
  scooter.position.set(0,0,0);
  heading=0; speed=0; wanted=false; gameOver=false;
  policeCars.forEach((c,i)=>c.position.set((i-1)*4,0,-15-i*9));
  messageEl.textContent='Fahre los!';
};

function update(dt){
  const forward=keys['w']||keys['arrowup'];
  const backward=keys['s']||keys['arrowdown'];
  const left=keys['a']||keys['arrowleft'];
  const right=keys['d']||keys['arrowright'];
  const turbo=keys['shift'];

  const accelerating=gas||forward;
  const braking=brake||backward;

  if(!gameOver){
    if(accelerating)speed+= (turbo?19:12)*dt;
    else speed-=5*dt;
    if(braking)speed-=19*dt;
    speed=THREE.MathUtils.clamp(speed,-8,maxSpeed*(turbo?1.3:1));

    const steerInput=(left||steer===-1?-1:0)+(right||steer===1?1:0);
    heading+=steerInput*dt*(0.75+Math.abs(speed)*0.035)*Math.sign(speed||1);
    scooter.rotation.y=heading;
    scooter.rotation.z=-steerInput*Math.min(Math.abs(speed)/30,1)*0.10;
    scooter.position.x+=Math.sin(heading)*speed*dt;
    scooter.position.z+=Math.cos(heading)*speed*dt;

    if(Math.abs(scooter.position.x)>285||Math.abs(scooter.position.z)>285){
      scooter.position.x=THREE.MathUtils.clamp(scooter.position.x,-285,285);
      scooter.position.z=THREE.MathUtils.clamp(scooter.position.z,-285,285);
    }
    if(Math.abs(speed)>9)wanted=true;

    policeCars.forEach((car,i)=>{
      const target=new THREE.Vector3(
        scooter.position.x-Math.sin(heading)* (8+i*3),
        0,
        scooter.position.z-Math.cos(heading)*(8+i*3)
      );
      const delta=target.clone().sub(car.position);
      const distance=delta.length();
      if(distance>0.01){
        delta.normalize();
        car.position.addScaledVector(delta,Math.min((wanted?11:5+i)*dt,distance));
        car.rotation.y=Math.atan2(delta.x,delta.z);
      }
      // Keep a minimum gap to avoid cars sitting on the scooter
      if(distance<3){
        speed*=0.95;
        messageEl.textContent='Die Polizei ist ganz nah!';
      }
    });
    if(wanted)messageEl.textContent='ACHTUNG! Die Polizei verfolgt dich!';
  }

  speedEl.textContent=Math.round(Math.abs(speed)*3.6);
  policeEl.textContent=wanted?'Verfolgung!':'Sucht dich';
}

// Third-person follow camera
const cameraOffset=new THREE.Vector3(0,5.4,-10.5);
const desired=new THREE.Vector3();
const lookTarget=new THREE.Vector3();
let last=performance.now();

function animate(now){
  requestAnimationFrame(animate);
  const dt=Math.min((now-last)/1000,0.04);
  last=now;
  update(dt);

  const offset=cameraOffset.clone().applyAxisAngle(
    new THREE.Vector3(0,1,0),heading);
  desired.copy(scooter.position).add(offset);
  camera.position.lerp(desired,1-Math.pow(0.001,dt));
  lookTarget.copy(scooter.position);
  lookTarget.y+=1.3;
  lookTarget.x+=Math.sin(heading)*4;
  lookTarget.z+=Math.cos(heading)*4;
  camera.lookAt(lookTarget);

  renderer.render(scene,camera);
}
requestAnimationFrame(animate);

addEventListener('resize',()=>{
  camera.aspect=innerWidth/innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth,innerHeight);
});
</script>
</body>
</html>
